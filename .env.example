# =============================================================================
# Panitas — Plantilla de Variables de Entorno (.env.example)
# =============================================================================
# Copia este archivo a los archivos reales según tu entorno:
#   .env.local      → desarrollo local
#   .env.production → despliegue en producción (Vercel)
#
# REGLAS:
#   - NUNCA subas archivos .env con valores reales a Git (ver .gitignore)
#   - Las variables NEXT_PUBLIC_* son públicas (se incrustan en el bundle)
#   - Solo .env.example está versionado como plantilla pública
# =============================================================================

# ─── Base de datos (PostgreSQL) ─────────────────────────────────────────────
# Producción: Neon (postgresql://...neon.tech). Local: Docker (panitas-pg).
DATABASE_URL="postgresql://user:password@localhost:5432/panitas?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/panitas?schema=public"
# BD vacía de escratch para operaciones de migración (shadow). NUNCA la misma que DATABASE_URL.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/panitas_shadow?schema=public"

# ─── URLs públicas ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_BASE_URL: sitemap/SEO/JSON-LD. NEXT_PUBLIC_APP_URL: enlaces de la app.
# En producción: https://panitas.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Autenticación (Auth.js v5) ─────────────────────────────────────────────
# AUTH_SECRET es la variable primaria; NEXTAUTH_SECRET es alias legacy.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (opcional, login con Google) ──────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Admin interno ──────────────────────────────────────────────────────────
# ADMIN_SECRET autentica el panel /admin. ADMIN_EMAIL = superadmin inicial.
ADMIN_SECRET=""
ADMIN_EMAIL="admin@example.com"

# ─── Cron (verificar que coincide con headers en Vercel) ────────────────────
CRON_SECRET=""

# ─── Cloudinary (uploads de imágenes/videos) ────────────────────────────────
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Crear API key en https://resend.com/api-keys
RESEND_API_KEY=""

# ─── Twilio (opcional, verificación SMS) ────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_PHONE_NUMBER=""

# ─── Pusher (realtime: POS, escáner, sincronización) ───────────────────────
# Las NEXT_PUBLIC_* son seguras para el cliente.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ─── Vendedores (JWT propio) ────────────────────────────────────────────────
SELLER_JWT_SECRET=""

# ─── OpenRouter (IA — Agent Core FASE 3A, proveedor activo) ─────────────────
# Obtener key en https://openrouter.ai/keys. NUNCA subir la key a Git.
# El agent de Panitas usa OpenRouter con DeepSeek V4 Flash por defecto.
OPENROUTER_API_KEY=""

# ─── NVIDIA NIM (IA — respaldo) ─────────────────────────────────────────────
# Obtener key en https://build.nvidia.com (Build API, gratis). NUNCA subir la key a Git.
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# ─── Proveedor activo del Agent Core ────────────────────────────────────────
# Valores: "openrouter" (activo) u "nvidia" (respaldo).
AI_PROVIDER="openrouter"

# ─── OpenRouter (IA — identidad de la app) ──────────────────────────────────
# Base URL / identidad de la app (se envían como headers HTTP-Referer / X-OpenRouter-Title).
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_APP_TITLE="Panitas"
OPENROUTER_HTTP_REFERER="https://panitas.app"

# Modelo por tipo de tarea. El agent usa DeepSeek V4 Flash vía OpenRouter;
# para cambiar solo edita la variable (sin tocar código).
CHAT_MODEL="deepseek/deepseek-v4-flash"
BUSINESS_MODEL="deepseek/deepseek-v4-flash"
JSON_MODEL="deepseek/deepseek-v4-flash"
CLASSIFICATION_MODEL="deepseek/deepseek-v4-flash"
SUMMARIZATION_MODEL="deepseek/deepseek-v4-flash"
REPLY_SUGGESTION_MODEL="deepseek/deepseek-v4-flash"
# Clasificación de inventario en importación (fallback: CHAT_MODEL).
AI_INVENTORY_MODEL="deepseek/deepseek-v4-flash"

# Proveedor por tarea (default: openrouter) y ajustes por tarea (opcional).
# Ej. CHAT_MODEL_PROVIDER="openrouter", CHAT_MODEL_TEMPERATURE="0.7", CHAT_MODEL_MAX_TOKENS="1000"
AI_PROVIDER="openrouter"
# Alias legacy de la key de NVIDIA (si se usa NVIDIA_NIM_API_KEY no hace falta).
NVIDIA_API_KEY=""

# Timeout (ms) y reintentos por llamada al proveedor.
AI_TIMEOUT_MS="30000"
AI_RETRIES="2"

# ─── WhatsApp Cloud API (inbox) ────────────────────────────────────────────
# Multi-tenant: el token de cada negocio vive en ChannelConnection (BD).
# Estas variables configuran la APP compartida de Meta. Ver en Meta Developers.
# El APP_SECRET verifica la firma HMAC de los webhooks (no se expone jamás).
WHATSAPP_API_VERSION="v22.0"
WHATSAPP_BASE_URL="https://graph.facebook.com"
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_DEFAULT_ACCESS_TOKEN=""
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=""
WHATSAPP_TIMEOUT_MS="15000"

# ─── Meta — Instagram + Messenger (inbox) ──────────────────────────────────
# Comparten la misma App de Meta (mismo App Secret / verify token que WhatsApp).
META_API_VERSION="v22.0"
META_BASE_URL="https://graph.facebook.com"
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_TIMEOUT_MS="15000"

# ─── PostHog (analítica de producto) ────────────────────────────────────────
# Tokens public_* son seguros de exponer.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
# POSTHOG_PROJECT_SECRET_KEY=""  # Server-side only (prefijo phs_). Feature flags / remote config.
# POSTHOG_PERSONAL_API_KEY=""    # Management API (prefijo phx_). Opcional.

# ─── Monitoreo de tasa BCV (opcional) ───────────────────────────────────────
# Controla el scheduler que consulta la tasa de cambio (defaults razonables).
BCV_MONITOR_START_HOUR="8"
BCV_MONITOR_END_HOUR="18"
BCV_QUERY_INTERVAL_HOURS="6"
BCV_TIMEZONE="America/Caracas"

# ─── Redis/Upstash (opcional, para rate limiting avanzado) ──────────────────
# Si no se configuran, el rate limiter usa memoria en proceso.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""
