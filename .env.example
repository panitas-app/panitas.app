# =============================================================================
# Panitas — Variables de Entorno
# Copia este archivo como .env y completa los valores
# =============================================================================

# ─── Base de datos ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/panitas_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/panitas_db?schema=public"

# ─── URL base (pública) ──────────────────────────────────────────────────────
# Usado para sitemap, SEO, JSON-LD. En producción: https://panitas.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── NextAuth ───────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (opcional, para login con Google) ─────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Admin ──────────────────────────────────────────────────────────────────
# Se genera automáticamente al abrir admin.bat
ADMIN_SECRET=""

# ─── Cron ───────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ─── Cloudinary (para subir imágenes) ───────────────────────────────────────
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Crear API key en https://resend.com/api-keys
RESEND_API_KEY=""

# ─── Twilio (opcional, para verificación SMS) ───────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_PHONE_NUMBER=""

# ─── Redis (opcional, para rate limiting) ───────────────────────────────────
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxx"

# ─── OpenRouter (IA para importación de inventarios) ────────────────────────
# Obtener key en https://openrouter.ai/keys
# Free tier: 50 req/día. Con $10+ créditos: 1000 req/día.
OPENROUTER_API_KEY=""

# ─── Email (SMTP legacy, opcional) ─────────────────────────────────────────
# Solo si no usas Resend. Si está vacío, los emails se loguean en consola.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@panitas.app
